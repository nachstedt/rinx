"""
rusty_sphinx — Bazel module declaration.

This directory contains the Starlark rules that expose rusty_sphinx_library
and rusty_sphinx_site to downstream Bazel workspaces.

The Rust binary (worker) is NOT built inside this module. Instead, consuming
workspaces must provide it by overriding the `_worker` attribute or by
registering a `@rusty_sphinx_toolchains//:worker` target.  The example
workspace in examples/bazel_workspace shows how to do this with rules_rust.
"""

module(
    name = "rusty_sphinx",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
