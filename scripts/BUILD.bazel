load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# `rinx_doctest_tests` generates a `py_test` whose `srcs` is the runner
# itself, so the source file has to be visible to the packages that use the
# macro.
exports_files(["doctest_runner.py"])

py_library(
    name = "benchmark_lib",
    srcs = [
        "benchmark.py",
        "benchmark_common.py",
        "benchmark_entities.py",
        "needs_schema.py",
    ],
    # Add this package dir to sys.path so `import benchmark` resolves as a
    # top-level module (both for the binaries and the tests).
    imports = ["."],
)

# The CPython benchmark: general RST coverage. See docs/benchmark.rst.
py_binary(
    name = "benchmark",
    srcs = [
        "benchmark.py",
        "benchmark_common.py",
    ],
    # `import benchmark_common` has to resolve as a top-level module, the same
    # way it does for benchmark_lib's tests.
    imports = ["."],
)

# The sphinx-needs benchmark: entity-model coverage. Shares the plumbing in
# benchmark_common.py, and converts the corpus' own configuration through
# needs_schema.py.
py_binary(
    name = "benchmark_entities",
    srcs = [
        "benchmark_common.py",
        "benchmark_entities.py",
        "needs_schema.py",
    ],
    imports = ["."],
    main = "benchmark_entities.py",
)

# The doctest plan runner. Exposed as a library so `rinx_doctest_tests`
# can depend on it, and as a binary for running a plan by hand.
py_library(
    name = "doctest_runner_lib",
    srcs = ["doctest_runner.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "doctest_runner",
    srcs = ["doctest_runner.py"],
    visibility = ["//visibility:public"],
)

# Publishes the workspace's crates to crates.io in dependency order, skipping
# those already published and waiting out crates.io's rate limit — the release
# workflow's crates step. See docs/dev/releasing.md.
py_library(
    name = "publish_crates_lib",
    srcs = ["publish_crates.py"],
    imports = ["."],
)

# Publishes a version of rinx's two sites to the gh-pages branch — every
# workflow writing that branch calls it. See docs/decisions/024-versioned-docs.md.
py_library(
    name = "publish_pages_lib",
    srcs = ["publish_pages.py"],
    imports = ["."],
)

# One pytest target per `*_test.py`, so an edit re-runs only the file it
# touches. Each runs under the repository's pyproject.toml — the configuration
# `uv run pytest` uses — so the two cannot disagree about how a test runs
# (`pythonpath`, `filterwarnings`, strict markers, ...). Naming the file only
# replaces `testpaths`, and the glob means a new test file needs no BUILD edit.
[
    py_test(
        name = src.removesuffix(".py"),
        size = "small",
        srcs = [
            src,
            "pytest_main.py",
        ],
        args = [
            "-c",
            "$(rootpath //:pyproject.toml)",
            "$(rootpath {})".format(src),
        ],
        data = ["//:pyproject.toml"],
        main = "pytest_main.py",
        deps = [
            ":benchmark_lib",
            ":doctest_runner_lib",
            ":publish_crates_lib",
            ":publish_pages_lib",
            "@pypi//pytest",
        ],
    )
    for src in glob(["*_test.py"])
]
