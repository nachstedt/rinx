load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# `rusty_sphinx_doctest_tests` generates a `py_test` whose `srcs` is the runner
# itself, so the source file has to be visible to the packages that use the
# macro.
exports_files(["doctest_runner.py"])

py_library(
    name = "benchmark_lib",
    srcs = ["benchmark.py"],
    # Add this package dir to sys.path so `import benchmark` resolves as a
    # top-level module (both for the binary and the test).
    imports = ["."],
    # deps = ["@pypi//some_package"], # add pip dependencies here when needed
)

py_binary(
    name = "benchmark",
    srcs = ["benchmark.py"],
)

py_test(
    name = "benchmark_test",
    size = "small",
    srcs = ["benchmark_test.py"],
    deps = [":benchmark_lib"],
)

# The doctest plan runner. Exposed as a library so `rusty_sphinx_doctest_tests`
# can depend on it, and as a binary for running a plan by hand.
py_library(
    name = "doctest_runner_lib",
    srcs = ["doctest_runner.py"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "doctest_runner",
    srcs = ["doctest_runner.py"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "doctest_runner_test",
    size = "small",
    srcs = ["doctest_runner_test.py"],
    deps = [":doctest_runner_lib"],
)
