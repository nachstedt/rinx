load("@rules_java//java:defs.bzl", "java_binary", "java_import")
load("//rules:plantuml.bzl", "plantuml_tool")

# The worker binary itself now lives at //crates/worker, split out into a
# Cargo workspace mirroring docs/dev/architecture.md's crate layout. This alias keeps
# the label stable for rules/library.bzl and rules/site.bzl, which reference
# it as a black-box CLI executable.
alias(
    name = "rinx",
    actual = "//crates/worker:rinx",
    visibility = ["//visibility:public"],
)

java_import(
    name = "plantuml_import",
    jars = ["@plantuml_jar//file"],
)

java_binary(
    name = "plantuml_binary",
    main_class = "net.sourceforge.plantuml.Run",
    runtime_deps = [":plantuml_import"],
)

# What rules/site.bzl runs: the binary above, pinned to the Java runtime the
# jar's ELK layout needs whatever the consuming build's flags say.
plantuml_tool(
    name = "plantuml_tool",
    binary = ":plantuml_binary",
    visibility = ["//visibility:public"],
)

exports_files([
    # The Python tooling's configuration, which `//scripts:tests` runs pytest
    # under, so a Bazel run and `uv run pytest` behave the same.
    "pyproject.toml",
    "templates/default.html",
    "templates/default_config.toml",
    "assets/default.css",
    "assets/version_switcher.js",
])
