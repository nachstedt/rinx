load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("@crates//:defs.bzl", "all_crate_deps")

rust_library(
    name = "rusty_sphinx",
    srcs = [
        "src/analyzer.rs",
        "src/ast.rs",
        "src/lib.rs",
        "src/parser.rs",
        "src/renderer.rs",
    ],
    deps = all_crate_deps(
        normal = True,
    ),
    edition = "2024",
    visibility = ["//visibility:public"],
)

rust_binary(
    name = "rusty_sphinx_worker",
    srcs = ["src/main.rs"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        ":rusty_sphinx",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
)
