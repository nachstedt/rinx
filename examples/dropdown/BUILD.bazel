"""Documents exercising every `.. dropdown::` option.

Its own library and package, mirroring `//examples/sectnum`'s shape: the
directive has ten options whose effects are visual and independent, so each
group gets a small page of its own rather than one page trying to show them
all at once.

The first third-party *extension* directive this build supports — see
`docs/compatibility.rst`'s "Extension directives" section.
"""

load("@rinx//:defs.bzl", "rinx_library")

rinx_library(
    name = "docs",
    srcs = glob(["*.rst"]),
    deps = [],
    visibility = ["//visibility:public"],
)
