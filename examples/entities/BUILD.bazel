"""Documents exercising the entity meta-model.

Its own library and package so that `entities.toml` — which is a *parse-time*
input, unlike the site's `rinx.toml` — is declared once, next to the
documents it gives a vocabulary to.

Note the schema is named twice: here, because these documents are parsed
against it, and on `//examples:site`, because the index action derives
back-links from it and each render action reads its labels. The two must be
the same file; a mismatch is reported as `entity.schema-mismatch`.
"""

load("@rinx//:defs.bzl", "rinx_library")

rinx_library(
    name = "docs",
    srcs = glob(
        ["*.rst"],
        exclude = ["diagrams.rst"],
    ),
    entity_schema = "entities.toml",
    # `imported.rst`'s `.. needimport::` reads this at parse time, the same way
    # a `.. csv-table::`'s `:file:` is read — a file the parser opens, not a
    # dependency on another library. Leave it out and the parse fails.
    parse_data = ["needs.json"],
    # `index.rst`'s toctree lists `diagrams`, so the dependency is required,
    # not just convenient — see `tests/test_strict_deps.sh`.
    deps = [":diagram_docs"],
    visibility = ["//visibility:public"],
)

# Note `charts.rst` is *not* here but in `:docs` above, and that is the whole
# point of it: an `.. entity-pie::` is drawn as inline SVG by the render action
# itself, so a library holding one needs no `diagrams` opt-in and gets no
# diagram actions at all. A chart costs a project nothing it does not use.

# The diagram documents live in a library of their own, which is the pattern
# the `diagrams` attribute is built for: diagram compilation is opt-in per
# library, so keeping the diagrams together keeps the cost on the documents
# that actually draw something. The rest of this package's documents get no
# diagram actions at all. (`//examples:doctest_docs` splits doctests out for
# the same reason.)
rinx_library(
    name = "diagram_docs",
    srcs = ["diagrams.rst"],
    entity_schema = "entities.toml",
    diagrams = True,
)

exports_files([
    "entities.toml",
    "entity_audit_event.html",
])
