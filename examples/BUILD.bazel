"""
Top-level example site.

Assembles the documentation from team_a and team_b into a single HTML site.

  bazel build //examples:site          # build the full example site
  bazel build //examples/team_a:docs   # build team_a in isolation
"""

load("@rusty_sphinx//:defs.bzl", "rusty_sphinx_library", "rusty_sphinx_site")

rusty_sphinx_library(
    name = "root_docs",
    srcs = ["index.rst", "hyperlinks.rst", "admonitions.rst", "inline_roles.rst", "version_changes.rst", "seealso.rst", "literal_blocks.rst", "glossary.rst", "definition_lists.rst", "comments.rst", "domains.rst", "current_module.rst", "transitions.rst", "typography.rst", "tables.rst", "list_table.rst", "index_entries.rst"],
    deps = [
        "//examples/team_a:docs",
        "//examples/team_b:docs",
    ],
)

rusty_sphinx_site(
    name = "site",
    config = "rusty_sphinx.toml",
    template = "custom_template.html",
    strict_links = True,
    deps = [
        ":root_docs",
        "//examples/team_a:docs",
        "//examples/team_b:docs",
    ],
)
