"""Team A documentation library."""

load("@rinx//:defs.bzl", "rinx_library")

rinx_library(
    name = "docs",
    srcs = glob(["*.rst"]),
    deps = [],
    default_domain = "c",
    # `index.rst` draws PlantUML diagrams, and diagram compilation is opt-in
    # per library — without this the parse fails, naming the attribute.
    diagrams = True,
    visibility = ["//visibility:public"],
)
