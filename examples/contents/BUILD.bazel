"""Documents exercising every `.. contents::` option.

Its own library and package, mirroring `//examples/toctree`'s shape for the
same reason: one page can show every option without competing with the rest
of the example site's own sections.
"""

load("@rinx//:defs.bzl", "rinx_library")

rinx_library(
    name = "docs",
    srcs = glob(["*.rst"]),
    deps = [],
    visibility = ["//visibility:public"],
)
