load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "rusty_sphinx_index",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//crates/ast:rusty_sphinx_ast",
        "//crates/entity:rusty_sphinx_entity",
        "//crates/filter:rusty_sphinx_filter",
    ],
