load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "rinx_lsp",
    srcs = glob(["src/**/*.rs"]),
    # Read by `include_str!`, and outside the `.rs` glob above.
    compile_data = ["src/project/extension_profiles.toml"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//crates/analyzer:rinx_analyzer",
        "//crates/ast:rinx_ast",
        "//crates/entity:rinx_entity",
        "//crates/index:rinx_index",
        "//crates/parser:rinx_parser",
        "//crates/pyconf:rinx_pyconf",
        "//crates/renderer:rinx_renderer",
        "//crates/toctree:rinx_toctree",
    ],
)
