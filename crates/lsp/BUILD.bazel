load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "rinx_lsp",
    srcs = glob(["src/**/*.rs"]),
    # Read by `include_str!`, and outside the `.rs` glob above. `theme/` holds
    # links to the default template and stylesheet at the repository's root,
    # which `cargo package` copies into the crate.
    compile_data = [
        "theme/default.css",
        "theme/default.html",
        "src/project/conf_dump.py",
        "src/project/extension_profiles.toml",
    ],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//crates/analyzer:rinx_analyzer",
        "//crates/ast:rinx_ast",
        "//crates/entity:rinx_entity",
        "//crates/index:rinx_index",
        "//crates/inventory:rinx_inventory",
        "//crates/parser:rinx_parser",
        "//crates/pyconf:rinx_pyconf",
        "//crates/renderer:rinx_renderer",
        "//crates/toctree:rinx_toctree",
    ],
)

# The script the server runs a project's `conf.py` with, embedded above; a
# library for `//scripts`' pytest targets, which test it.
py_library(
    name = "conf_dump_lib",
    srcs = ["src/project/conf_dump.py"],
    imports = ["src/project"],
    visibility = ["//scripts:__pkg__"],
)
