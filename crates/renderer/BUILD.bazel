load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "rinx_renderer",
    srcs = glob(["src/**/*.rs"]),
    # `chart/style.rs` reads the vendored font with `include_bytes!`, so it has
    # to be an input to the compile — it is not a `.rs` file, so the `srcs`
    # glob above does not reach it. See `fonts/README.md` for why the font is
    # vendored rather than found on the build host.
    compile_data = ["fonts/DejaVuSans.ttf"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        normal = True,
    ) + [
        "//crates/ast:rinx_ast",
        "//crates/filter:rinx_filter",
        "//crates/entity:rinx_entity",
        "//crates/toctree:rinx_toctree",
        "//crates/index:rinx_index",
        "//crates/uml:rinx_uml",
        "//crates/scope:rinx_scope",
    ],
)
