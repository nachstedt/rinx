{
  "name": "rinx",
  "displayName": "Rinx",
  "description": "Live preview and diagnostics for Rinx documentation",
  "version": "0.1.0",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nachstedt/rinx.git"
  },
  "publisher": "nachstedt",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:rinx.showPreview",
    "onLanguage:restructuredtext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rinx.showPreview",
        "title": "Rinx: Show Preview",
        "category": "Rinx"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Rinx",
      "properties": {
        "rinx.binaryPath": {
          "type": "string",
          "default": "rinx",
          "description": "Path to the rinx binary, used by the preview and the language server. Can be a bare command (if in PATH) or an absolute path (e.g., /usr/local/bin/rinx). When unset, the binary is discovered through Bazel, falling back to `rinx` on the PATH."
        },
        "rinx.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the rinx language server in the Rinx output channel."
        },
        "rinx.autoDiscover": {
          "type": "boolean",
          "default": true,
          "description": "Automatically discover configuration from Bazel. Requires `bazel` to be on the PATH."
        },
        "rinx.configPath": {
          "type": "string",
          "default": "rinx.toml",
          "description": "Fallback path to the rinx.toml config file (used when autoDiscover is disabled or fails)"
        },
        "rinx.templatePath": {
          "type": "string",
          "default": "templates/default.html",
          "description": "Fallback path to the HTML template used for rendering (used when autoDiscover is disabled or fails)"
        },
        "rinx.indexPath": {
          "type": "string",
          "default": "bazel-bin/Doc/site.project.index",
          "description": "Fallback path to the global project index (used when autoDiscover is disabled or fails)"
        },
        "rinx.previewMode": {
          "type": "string",
          "enum": [
            "onSave",
            "onType"
          ],
          "default": "onType",
          "description": "When to update the preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  }
}
