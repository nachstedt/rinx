"""
The rinx Bazel module: the rinx binary, built from the Cargo workspace under
crates/ with rules_rs, and the rules in defs.bzl that drive it.

Users depend on it with `bazel_dep(name = "rinx", ...)`; see README.md.
Everything marked `dev_dependency = True` below serves only this repository's
own examples, tests and scripts, and is invisible to such a user.

  bazel build //:rinx                  # build the binary
  bazel build //examples:site          # build the full example site
  bazel build //examples/team_a:docs   # build team_a in isolation
"""

module(
    name = "rinx",
    version = "0.2.0",
    bazel_compatibility = [">=8.7.0"],
)

# ── Rust toolchain and crates ─────────────────────────────────────────────────

bazel_dep(name = "rules_rs", version = "0.2.1")

# Declares the Rust version rinx needs (`rust-version` in Cargo.toml) without
# registering anything: rules_rs registers its default toolchains for every
# build depending on it, picking the highest version any module declares, and
# a root module's own declaration overrides them all.
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.98.1",
)
use_repo(toolchains, "default_rust_toolchains")

# Resolved from Cargo.lock directly; no lockfile of Bazel's own. The hub is
# named for rinx because rules_rs merges hubs of the same name across modules,
# and a depending build may well have a `crates` hub of its own.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "rinx_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "rinx_crates")

# ── Java toolchain & PlantUML ──────────────────────────────────────────────────

bazel_dep(name = "rules_java", version = "9.6.0")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "plantuml_jar",
    urls = ["https://repo1.maven.org/maven2/net/sourceforge/plantuml/plantuml/1.2026.8/plantuml-1.2026.8.jar"],
    sha256 = "0f77e5f769836b3dee340e207fe497c3e4c43e973d559e3c306915da9c32e34c",
    downloaded_file_path = "plantuml.jar",
)

# ── Python toolchain ──────────────────────────────────────────────────────────

bazel_dep(name = "rules_python", version = "2.0.0")

# `rules_python` is a regular dependency, since `rules/doctest.bzl` loads
# `py_test` from it in a user's build. The toolchain below is only this
# repository's, for `scripts/` and the `pip` hub: a `rinx_doctest_tests` runs on
# whatever Python the depending build defaults to, which is why
# `scripts/doctest_runner.py` must stay Python 3.9-compatible.
python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
    dev_dependency = True,
)
python.toolchain(
    python_version = "3.11",
    is_default = True,
)

# The Python packages `scripts/` may need. No rule of rinx's uses them, so a
# user of the module never resolves this hub.
pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
    dev_dependency = True,
)
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//scripts:requirements.txt",
)
use_repo(pip, "pypi")


# ── JavaScript tests ──────────────────────────────────────────────────────────

# Runs the default theme's browser script's tests (tests/js/) under a hermetic
# Node.js. The script itself is shipped to sites as a plain file, so no rule of
# rinx's needs Node and a user of the module never resolves this.
bazel_dep(name = "aspect_rules_js", version = "3.4.1", dev_dependency = True)
