"""
Root Bazel workspace for rusty-sphinx.

This workspace:
 - Builds the rusty-sphinx binary from src/ via rules_rust.
 - Loads the rusty_sphinx Starlark rules from the local bazel/ subdirectory.
 - Provides example documentation targets under examples/.

Quick start:
  bazel build //:rusty_sphinx_worker          # build the binary
  bazel build //examples:site                 # build the full example site
  bazel build //examples/team_a:docs          # build team_a in isolation
"""

module(
    name = "rusty_sphinx_workspace",
    version = "0.0.0",
)

# ── Local rules module ────────────────────────────────────────────────────────

bazel_dep(name = "rusty_sphinx", version = "0.0.0")

local_path_override(
    module_name = "rusty_sphinx",
    path = "bazel",
)

# ── Rust toolchain ────────────────────────────────────────────────────────────

bazel_dep(name = "rules_rust", version = "0.69.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# ── Crate dependencies (serde, serde_json) ────────────────────────────────────

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu",
    ],
)

use_repo(crate, "crates")

# ── Java toolchain & PlantUML ──────────────────────────────────────────────────

bazel_dep(name = "rules_java", version = "9.6.0")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "plantuml_jar",
    urls = ["https://repo1.maven.org/maven2/net/sourceforge/plantuml/plantuml/1.2024.4/plantuml-1.2024.4.jar"],
    sha256 = "a79ce5f149778886ef41d39738a28cae54eeb4a847def2ac771fccbf97ebdc5e",
    downloaded_file_path = "plantuml.jar",
)
